\contentsline {figure}{\numberline {1}{\ignorespaces Hành trình end-to-end của một giao dịch qua bốn thành phần.}}{20}{figure.1}%
\contentsline {figure}{\numberline {2}{\ignorespaces Các gói con của Core Service và luồng dữ liệu giữa chúng.}}{24}{figure.2}%
\contentsline {figure}{\numberline {3}{\ignorespaces Giao diện hàm (ABI) giữa host và contract WASM.}}{25}{figure.3}%
\contentsline {figure}{\numberline {4}{\ignorespaces Các gói con bên trong một node của Ordering Service và luồng đường ống commit block.}}{37}{figure.4}%
\contentsline {figure}{\numberline {5}{\ignorespaces Sơ đồ chuyển trạng thái của một node trong Ordering Service.}}{40}{figure.5}%
\contentsline {figure}{\numberline {6}{\ignorespaces Quy trình bầu lãnh đạo theo độ ưu tiên.}}{45}{figure.6}%
\contentsline {figure}{\numberline {7}{\ignorespaces Đường ống nhân bản và commit một block: đề xuất, chấp nhận theo quá bán, commit.}}{49}{figure.7}%
\contentsline {figure}{\numberline {8}{\ignorespaces Kiến trúc đường ống và các gói con của Committing Peer.}}{55}{figure.8}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {9}{\ignorespaces Tốc độ commit bám sát tốc độ gửi tới ít nhất 20.000 tx/s; trần thực đo ở tải không giới hạn là ${\sim }73.500$ tx/s.}}{72}{figure.9}%
\contentsline {figure}{\numberline {10}{\ignorespaces Thông lượng commit theo kích thước block: đạt đỉnh ${\sim }82.500$ tx/s ở block=250, với một vùng trũng lặp lại được ở block=1.000.}}{73}{figure.10}%
\contentsline {figure}{\numberline {11}{\ignorespaces Ở tải 5.000 tx/s: chu kỳ ngắn cho nhiều block nhỏ, chu kỳ dài cho ít block lớn (bão hòa ở kích thước lô 1.000); thông lượng commit không đổi ${\sim }5.000$ tx/s.}}{74}{figure.11}%
\contentsline {figure}{\numberline {12}{\ignorespaces Thông lượng theo số luồng gửi: vùng phẳng tối ưu ở 8--32 luồng (đỉnh tại 32, ${\sim }82.800$ tx/s), suy giảm khi vượt 32 do tranh chấp stream.}}{75}{figure.12}%
\contentsline {figure}{\numberline {13}{\ignorespaces ML-DSA-44: submit và commit bám nhau tới ${\sim }2$k tx/s; từ 2,5k trở lên commit suy giảm dù submit vẫn tăng --- dấu hiệu bão hòa pipeline.}}{79}{figure.13}%
\contentsline {figure}{\numberline {14}{\ignorespaces Ed25519: pipeline bám offer rate tới 4k tx/s; bão hòa nhẹ từ 5k với commit ${\sim }4,8$--$5,2$k tx/s.}}{80}{figure.14}%
\contentsline {figure}{\numberline {15}{\ignorespaces E2E p95 theo commit throughput: Ed25519 giữ độ trễ thấp tới ${\sim }5$k tx/s; ML-DSA-44 tăng vọt khi vượt trần ${\sim }2$k tx/s.}}{81}{figure.15}%
